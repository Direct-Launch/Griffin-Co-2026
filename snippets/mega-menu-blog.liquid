{% comment %}
  Renders a blog-post mega menu for a top-level navigation link.

  Accepts:
    - mega_menu_block: the header "Mega Menu - Blog Posts" block object (required)
    - link: the navigation link object (required)
    - context: 'desktop' (default) or 'mobile'

  Usage:
    {% render 'mega-menu-blog', mega_menu_block: block, link: link, context: 'desktop' %}
{% endcomment %}

{% liquid
  assign block = mega_menu_block

  if context == blank
    assign context = 'desktop'
  endif

  assign posts_limit = block.settings.blog_post_count | default: 3
  assign post_source = block.settings.blog_source | default: 'newest'

  comment
    Blogs to pull from. `blogs` can't be iterated, so the merchant picks up to
    three; their articles are merged and sorted newest first.
  endcomment
  assign blog_pool = '' | split: ','
  assign blogs_used = 0
  assign single_blog = blank
  for i in (1..3)
    if i == 1
      assign blog_key = 'blog'
    else
      assign blog_key = 'blog_' | append: i
    endif
    assign source_blog = blogs[block.settings[blog_key]]
    if source_blog != blank and source_blog.articles_count > 0
      assign blog_pool = blog_pool | concat: source_blog.articles
      assign blogs_used = blogs_used | plus: 1
      assign single_blog = source_blog
    endif
  endfor
  assign selected_blog = blogs[block.settings.blog]
  if selected_blog == blank
    assign selected_blog = single_blog
  endif

  comment
    One blog: its articles are already newest first. Several: merge and sort.
  endcomment
  if blogs_used == 1
    assign newest_articles = single_blog.articles
  elsif blogs_used > 1
    assign newest_articles = blog_pool | sort: 'published_at' | reverse
  else
    assign newest_articles = blog_pool
  endif

  assign use_pins = true
  assign use_newest = true
  if post_source == 'newest'
    assign use_pins = false
  elsif post_source == 'pinned'
    assign use_newest = false
  endif

  assign pinned_list = ''
  if use_pins
    for i in (1..4)
      assign pinned_key = 'blog_article_' | append: i
      assign pinned_article = block.settings[pinned_key]
      if pinned_article != blank
        assign pinned_list = pinned_list | append: pinned_article.handle | append: ','
      endif
    endfor
  endif
  assign pinned_handles = pinned_list | split: ','

  comment
    Links column: a chosen menu overrides this menu item's own links.
  endcomment
  assign nav_links = link.links
  if block.settings.links_menu != blank
    assign nav_links = block.settings.links_menu.links
  endif

  if context == 'mobile'
    assign show_links = block.settings.show_mega_menu_links_mobile
  else
    assign show_links = block.settings.show_mega_menu_links_desktop
  endif

  assign hide_links = false
  if nav_links.size == 0 or show_links == false
    assign hide_links = true
  endif

  assign links_columns = block.settings.links_columns | default: '2'
  assign links_heading = block.settings.links_heading
  assign links_width = block.settings.links_width | default: 'balanced'

  comment
    Card options.
  endcomment
  assign image_shape = block.settings.blog_image_shape | default: 'wide'
  assign show_date = block.settings.blog_show_date
  assign show_excerpt = block.settings.blog_show_excerpt
  assign show_tag = block.settings.blog_show_tag

  comment
    Column count. 'auto' gives one column per post (up to the post count);
    a fixed number lets the posts wrap onto multiple rows.
  endcomment
  assign columns_desktop = block.settings.blog_columns_desktop | default: 'auto'
  assign mobile_card_width = block.settings.blog_card_width_mobile | default: 65

  comment
    Browse row: a chosen menu of blog types and/or the article tags of the
    selected blogs.
  endcomment
  assign taxonomy_source = block.settings.blog_taxonomy_source | default: 'tags'
  assign taxonomy_heading = block.settings.blog_taxonomy_heading
  assign taxonomy_limit = block.settings.blog_taxonomy_limit | default: 8
  assign taxonomy_menu = block.settings.blog_taxonomy_menu

  assign show_taxonomy = true
  if taxonomy_source == 'none'
    assign show_taxonomy = false
  endif
  if context == 'mobile' and block.settings.blog_taxonomy_show_mobile == false
    assign show_taxonomy = false
  endif

  assign heading = block.settings.blog_heading
  assign view_all_label = block.settings.blog_view_all_label
  assign view_all_link = block.settings.blog_view_all_link
  if view_all_link == blank and selected_blog != blank
    assign view_all_link = selected_blog.url
  endif
%}

{%- capture post_cards -%}
  {%- assign rendered = 0 -%}

  {%- if use_pins -%}
    {%- for i in (1..4) -%}
      {%- assign pinned_key = 'blog_article_' | append: i -%}
      {%- assign pinned_article = block.settings[pinned_key] -%}
      {%- if pinned_article != blank and rendered < posts_limit -%}
        <div class="mega-menu-blog__item">
          {%- render 'blog-post-card',
            post: pinned_article,
            show_image: true,
            show_date: show_date,
            show_excerpt: show_excerpt,
            show_tags: show_tag,
            tags_limit: 1,
            image_shape: image_shape,
            alignment: 'left',
            heading_font_size: 'h6',
            heading_font_size_mobile: 'h5-mobile'
          -%}
        </div>
        {%- assign rendered = rendered | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if use_newest -%}
    {%- for article in newest_articles -%}
      {%- if rendered >= posts_limit -%}
        {%- break -%}
      {%- endif -%}
      {%- unless pinned_handles contains article.handle -%}
        <div class="mega-menu-blog__item">
          {%- render 'blog-post-card',
            post: article,
            show_image: true,
            show_date: show_date,
            show_excerpt: show_excerpt,
            show_tags: show_tag,
            tags_limit: 1,
            image_shape: image_shape,
            alignment: 'left',
            heading_font_size: 'h6',
            heading_font_size_mobile: 'h5-mobile'
          -%}
        </div>
        {%- assign rendered = rendered | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if rendered == 0 and request.design_mode -%}
    {%- for i in (1..posts_limit) -%}
      <div class="mega-menu-blog__item">
        {%- render 'blog-post-card',
          show_image: true,
          show_date: show_date,
          show_excerpt: show_excerpt,
          show_tags: show_tag,
          tags_limit: 1,
          image_shape: image_shape,
          alignment: 'left',
          heading_font_size: 'h6',
          heading_font_size_mobile: 'h5-mobile'
        -%}
      </div>
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign has_posts = post_cards | strip -%}

{%- capture taxonomy_pills -%}
  {%- if show_taxonomy -%}
    {%- if taxonomy_source == 'menu' or taxonomy_source == 'both' -%}
      {%- for menu_link in taxonomy_menu.links limit: taxonomy_limit -%}
        <a class="mega-menu-blog__pill mega-menu-blog__pill--menu custom-badge badge{% if menu_link.active %} is-active{% endif %}" href="{{ menu_link.url }}">
          {{- menu_link.title | escape -}}
        </a>
      {%- endfor -%}
    {%- endif -%}

    {%- if taxonomy_source == 'tags' or taxonomy_source == 'both' -%}
      {%- assign tags_shown = 0 -%}
      {%- for i in (1..3) -%}
        {%- if i == 1 -%}
          {%- assign blog_key = 'blog' -%}
        {%- else -%}
          {%- assign blog_key = 'blog_' | append: i -%}
        {%- endif -%}
        {%- assign tag_blog = blogs[block.settings[blog_key]] -%}
        {%- if tag_blog != blank -%}
          {%- for blog_tag in tag_blog.all_tags -%}
            {%- if tags_shown >= taxonomy_limit -%}
              {%- break -%}
            {%- endif -%}
            <a class="mega-menu-blog__pill mega-menu-blog__pill--tag custom-badge badge" href="{{ tag_blog.url }}/tagged/{{ blog_tag | handle }}">
              {{- blog_tag | escape -}}
            </a>
            {%- assign tags_shown = tags_shown | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign has_taxonomy = taxonomy_pills | strip -%}

{%- capture taxonomy_row -%}
  {%- if has_taxonomy != blank -%}
    <div class="mega-menu-blog__taxonomy">
      {% if taxonomy_heading != blank %}
        <p class="mega-menu-blog__taxonomy-heading">{{ taxonomy_heading | escape }}</p>
      {% endif %}
      <div class="mega-menu-blog__pills">{{ taxonomy_pills }}</div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{% if context == 'mobile' %}

  {% comment %} Links from a chosen menu. This menu item's own links are rendered by the header. {% endcomment %}
  {% if block.settings.links_menu != blank and hide_links == false %}
    {% for sub_link in nav_links %}
      <li class="mobile-nav__item mega-menu-blog__mobile-link">
        <div class="mobile-nav__link-wrapper">
          <a href="{{ sub_link.url }}" class="mobile-nav__link">{{ sub_link.title | escape }}</a>
        </div>
        {% if sub_link.links.size > 0 %}
          <ul class="mega-menu-blog__mobile-sublinks">
            {% for sub_sub_link in sub_link.links %}
              <li><a href="{{ sub_sub_link.url }}" class="mobile-nav__link">{{ sub_sub_link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  {% endif %}

  {% if has_posts != blank or has_taxonomy != blank %}
    <li class="mobile-nav__item mega-menu-blog__mobile">
      {% if heading != blank and has_posts != blank %}
        <p class="h5 mega-menu-blog__heading">{{ heading | escape }}</p>
      {% endif %}

      {% if has_posts != blank %}
        <div
          class="mega-menu-blog__scroller"
          data-post-count="{{ rendered }}"
          style="--mm-blog-card-basis: {{ mobile_card_width }}%;"
        >
          {{ post_cards }}
        </div>
      {% endif %}

      {% if view_all_label != blank and view_all_link != blank and has_posts != blank %}
        <div class="mega-menu-blog__view-all text-link-animated">
          <a href="{{ view_all_link }}">{{ view_all_label | escape }}</a>
        </div>
      {% endif %}

      {{ taxonomy_row }}
    </li>
  {% endif %}

{% else %}

  {%- liquid
    if columns_desktop == 'auto'
      assign grid_columns = rendered | at_least: 1
    else
      assign grid_columns = columns_desktop | plus: 0
      if grid_columns > rendered and rendered > 0
        assign grid_columns = rendered
      endif
      assign grid_columns = grid_columns | at_least: 1
    endif

    case links_width
      when 'narrow'
        assign panel_columns = '1fr 3fr'
      when 'wide'
        assign panel_columns = '1fr 1fr'
      else
        assign panel_columns = '1fr 2fr'
    endcase
  -%}

  {% style %}
    [data-mega-menu-block-id="{{ block.id }}"] {
      --mm-blog-panel-columns: {{ panel_columns }};
      --mm-blog-links-columns: {{ links_columns }};
      --mm-blog-grid-columns: {{ grid_columns }};
    }
  {% endstyle %}

  <div
    class="mega-menu-block mega-menu-blog{% if hide_links %} mega-menu-blog--no-links{% endif %}{% if has_posts == blank and has_taxonomy == blank %} no--content{% if request.design_mode %} no--content-design-mode{% endif %}{% endif %}"
    data-mega-menu-block-id="{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {% if hide_links == false %}
      <div class="mega-menu-blog__links-panel">
        {% if links_heading != blank %}
          <p class="mega-menu-blog__links-heading">{{ links_heading | escape }}</p>
        {% endif %}

        <div class="mega-menu--links mega-menu-blog__links">
          {% for sub_link in nav_links %}
            <li class="dropdown-submenu nav-link-animated--custom" aria-haspopup="true">
              <div class="inner">
                <div class="mega-menu-link-wrapper">
                  <p class="h4 mega-menu-link--title">
                    <a class="animated-link--item" href="{{ sub_link.url }}">{{ sub_link.title | escape }}</a>
                  </p>
                </div>

                {% if sub_link.links.size > 0 %}
                  <ul class="menu-link">
                    {% for sub_sub_link in sub_link.links %}
                      <li>
                        <div class="mega-menu-link-wrapper">
                          <a class="animated-link--item" href="{{ sub_sub_link.url }}">{{ sub_sub_link.title | escape }}</a>
                        </div>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if has_posts != blank or has_taxonomy != blank %}
      <div class="mega-menu-blog__posts">
        {% if has_posts != blank %}
          {% if heading != blank or view_all_label != blank %}
            <div class="mega-menu-blog__posts-header">
              {% if heading != blank %}
                <p class="h4 mega-menu-blog__heading">{{ heading | escape }}</p>
              {% endif %}
              {% if view_all_label != blank and view_all_link != blank %}
                <div class="mega-menu-blog__view-all text-link-animated">
                  <a href="{{ view_all_link }}">{{ view_all_label | escape }}</a>
                </div>
              {% endif %}
            </div>
          {% endif %}

          <div class="mega-menu-blog__grid">
            {{ post_cards }}
          </div>
        {% endif %}

        {{ taxonomy_row }}
      </div>
    {% elsif hide_links %}
      <p class="mega-menu--empty" {% unless request.design_mode %}style="visibility:hidden;"{% endunless %}>
        {{ 'layout.header.mega_menu_empty' | t }}
      </p>
    {% endif %}
  </div>

{% endif %}
